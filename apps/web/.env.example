# Postgres connection string, e.g. postgresql://user:password@localhost:5432/ddn_portal
DATABASE_URL=

# Auth.js v5 (Credentials provider, JWT sessions) -- generate with `npx auth secret`
AUTH_SECRET=

# Geocoding provider for the v1 bridge (packages/bridge) -- Nominatim
# (OpenStreetMap), the only geocoding provider this repo uses (CLAUDE.md).
# No API key; Nominatim's usage policy requires a descriptive User-Agent
# identifying the app and a contact, e.g. "ddn-portal (ops@example.com)".
NOMINATIM_USER_AGENT=

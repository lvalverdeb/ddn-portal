# Postgres connection string, e.g. postgresql://user:password@localhost:5432/ddn_portal
DATABASE_URL=

# Auth.js v5 (database sessions) -- generate with `npx auth secret`
AUTH_SECRET=

# Email (magic link) provider -- any nodemailer-compatible SMTP URL
EMAIL_SERVER=smtp://user:password@smtp.example.com:587
EMAIL_FROM="DDN Portal <noreply@example.com>"

# Geocoding provider for the v1 bridge (packages/bridge). Placeholder choice
# per the architecture plan's open items -- revisit before any real tenant.
MAPBOX_API_KEY=

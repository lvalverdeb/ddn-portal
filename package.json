{
  "name": "ddn-portal",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test && vitest run",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @ddn-portal/db generate",
    "db:migrate": "pnpm --filter @ddn-portal/db migrate",
    "db:seed": "pnpm --filter @ddn-portal/db seed"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
